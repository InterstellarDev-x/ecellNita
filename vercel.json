{
  "builds": [
    { "src": "backend/index.js", "use": "@vercel/node" },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "build": {
    "env": {
      "REACT_APP_BASE_URL": "/api/v1"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}
